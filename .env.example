# Agent memory: a Meko API key (mekodata.ai > Settings > API Keys). Never commit the real .env.
MEKO_API_KEY=
# Prefix for the datapacks Larp creates (<team>-agent-…, <team>-space-…). Datapack names are unique across all of Meko, so pick your own.
LARP_TEAM=divik-larp
# Optional: YugabyteDB for state, events and the Meko call log.
# Aeon: Connect > copy the connection string; download the CA cert and point YUGABYTE_CA at it.
YUGABYTE_URL=
YUGABYTE_CA=
# Optional: full path to the Codex CLI, if it is not the `codex` on your PATH.
LARP_CODEX=
