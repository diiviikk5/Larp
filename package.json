{
  "name": "larp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node test/e2e.mjs",
    "coordinator": "node server/cli.mjs",
    "test:loop": "node test/openai-loop.mjs",
    "test:ui": "node test/ui.mjs",
    "test:ports": "node test/port-fallback.mjs",
    "test:agents": "node test/real-agents.mjs",
    "detect": "node test/detect.mjs",
    "meko:check": "node test/meko-check.mjs",
    "test:memory": "node test/memory.mjs",
    "test:sql": "node test/pg-standin.mjs",
    "db:check": "node test/db-check.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:hosted": "node test/hosted.mjs",
    "test:packaged": "node test/packaged.mjs",
    "test:ocean": "node test/ocean-apps.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "description": "A shared workspace where people's AI agents work together, each on its owner's machine.",
  "author": "Divik Arora",
  "build": {
    "appId": "app.larp.desktop",
    "productName": "Larp",
    "copyright": "Copyright © 2026 Divik Arora",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "public/larp-icon.png",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/larp-icon.png",
      "artifactName": "Larp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Larp"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/larp-icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Larp-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/larp-icon.png",
      "category": "Development",
      "artifactName": "Larp-${version}.${ext}"
    }
  }
}
